# Variables de entorno de [NOMBRE-PRODUCTO].
#
# Uso local:  cp .env.example .env.local   y completá lo que falte.
# NUNCA commitees .env.local ni pegues claves reales en este archivo.
# Las variables con prefijo NEXT_PUBLIC_ llegan al navegador: nada sensible ahí.

# URL del proyecto Supabase. En local es la que muestra `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clave publicable de Supabase (empieza con sb_publishable_). Es pública y
# funciona porque todas las tablas tienen RLS. Completala con la de tu proyecto.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta de Supabase (empieza con sb_secret_). SOLO servidor: la lee
# únicamente src/shared/db/admin.ts. Dejala vacía acá y completala en .env.local
# o en las variables de Vercel.
SUPABASE_SECRET_KEY=

# URL base de la app, usada en los redirects de Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Id del proyecto Supabase. Solo desarrollo y CI (generación de tipos).
SUPABASE_PROJECT_ID=

# DSN de Sentry (opcional, observabilidad de errores). Es sensible: dejalo vacío acá.
SENTRY_DSN=
