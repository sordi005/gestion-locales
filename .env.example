# Variables de entorno de [NOMBRE-PRODUCTO].
#
# Uso local:  cp .env.example .env.local   y completá lo que falte.
# NUNCA commitees .env.local ni pegues claves reales en este archivo.
# Las variables con prefijo NEXT_PUBLIC_ llegan al navegador: nada sensible ahí.

# URL del proyecto Supabase. En local es la que muestra `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clave publicable de Supabase (empieza con sb_publishable_). Es pública y
# funciona porque todas las tablas tienen RLS. Completala con la de tu proyecto.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta de Supabase (empieza con sb_secret_). SOLO servidor: dentro de
# src/ la leen únicamente src/shared/lib/env.ts y src/shared/db/admin.ts. Los
# helpers de los tests E2E (tests/e2e/support/supabase-admin.ts) también la leen,
# pero solo contra Supabase local y nunca desde el cliente de la app. Dejala vacía
# acá y completala en .env.local o en las variables de Vercel.
SUPABASE_SECRET_KEY=

# URL base de la app, usada en los redirects de Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL de Mailpit, el buzón local donde llegan los emails de Auth (invitaciones y
# recupero de contraseña). Solo la usan los tests E2E (el setup global la exige) y
# tiene que ser local: con otro host los E2E se niegan a correr. En local es la que
# muestra `supabase status`.
MAILPIT_URL=http://127.0.0.1:54324

# Id del proyecto Supabase. Solo desarrollo y CI (generación de tipos).
SUPABASE_PROJECT_ID=

# DSN de Sentry (opcional, observabilidad de errores). Es sensible: dejalo vacío acá.
SENTRY_DSN=
